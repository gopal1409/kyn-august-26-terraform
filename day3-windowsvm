###first inside the vm.tf file on the first line /*   and end of the */
  ##we will create a new file winvm.tf copy from line 3 till 27 
  resource "azurerm_windows_virtual_machine" "myvm" {
  name                = "gopal-win-vm"
  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location
  size                = "Standard_B2s"

  admin_username = "azureadmin"
  admin_password = "ChangeThisPassword123!"

  network_interface_ids = [
    azurerm_network_interface.mynic.id #change this with your nic card
  ]

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "microsoftwindowsdesktop"
    offer     = "windows-11"
    sku       = "win11-25h2-pro"
    version   = "latest"
  }
}


  ################################create a new file to execute the powershell script winpower.tf copy from line 31 till 46
  resource "azurerm_virtual_machine_extension" "powershell" {
  name                 = "windows-configuration"
  virtual_machine_id   = azurerm_windows_virtual_machine.myvm.id

  publisher            = "Microsoft.Compute"
  type                 = "CustomScriptExtension"
  type_handler_version = "1.10"

  settings = jsonencode({
    fileUris = [
      "https://raw.githubusercontent.com/gopal1409/kyn-august-26-terraform/refs/heads/main/install.ps1"
    ]

    commandToExecute = "powershell.exe -ExecutionPolicy Unrestricted -File install.ps1"
  })
}

