#inside networking folder main.tf copy from line 49 till 115
#vnet
resource "azurerm_virtual_network" "vnet" {
  name                = "${var.name_prefix}-${var.vnet_name}" #gopal-network
  location            = azurerm_resource_group.myrg.location    #it will read your stae file and get the location of resource group
  resource_group_name = azurerm_resource_group.myrg.name
  address_space       = var.address_space
  tags                = var.project_tags

}

#ssubnet
#subnet need two information
# vnet name and resource group 
resource "azurerm_subnet" "web_subnet" {
  name                 = "${var.name_prefix}-${var.subnet_name}" #websubnet-subnet
  resource_group_name  = azurerm_resource_group.myrg.name
  virtual_network_name = azurerm_virtual_network.vnet.name
  address_prefixes     = ["10.0.1.0/24"]


}
#nsg
##we need to create an nsg

resource "azurerm_network_security_group" "web_nsg" {
  name                = "${var.name_prefix}-nsg"
  location            = azurerm_resource_group.myrg.location
  resource_group_name = azurerm_resource_group.myrg.name

  tags = var.project_tags
}
##this nsg need to be mapped with whom subnet
resource "azurerm_subnet_network_security_group_association" "web_subnet_nsg_association" {

  subnet_id                 = azurerm_subnet.web_subnet.id              #change it to your subnet refrence block
  network_security_group_id = azurerm_network_security_group.web_nsg.id #change it to your refrence block
}
##inside the nsg we need to create rules for inbound traffic
#inside nsg we need to allow some port 22 , 80 , 443 i cant take this port as range
locals {
  web_nsg_rule = { #named expression
    "110" : "3389",  #expression on key value format seprated priority and port number
    "120" : "80",
    "130" : "443",
    "140" : 22,
    "144" : 8080,
  }
}

/*
locals {
  ports = csvdecode(file("${path.module}/ports.csv"))
}*/
resource "azurerm_network_security_rule" "web_nsg" {
 for_each                    = local.web_nsg_rule

  name                        = "Rule_port_${each.key}" #Rule_port_110
  priority                    = each.key                #110
  direction                   = "Inbound"
  access                      = "Allow"
  protocol                    = "Tcp"
  source_port_range           = "*"
  destination_port_range      = each.value #22
  source_address_prefix       = "*"        #0.0.0.0/0
  destination_address_prefix  = "*"
  resource_group_name         = azurerm_resource_group.myrg.name
  network_security_group_name = azurerm_network_security_group.web_nsg.name
}
