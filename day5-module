8. loadbalancer/main.tf
Public IP
resource "azurerm_public_ip" "lb_public_ip" {
  name                = "${var.name_prefix}-lb-ip"
  resource_group_name = var.resource_group_name
  location            = var.location


  allocation_method = "Static"
  sku               = "Standard"
}
Load Balancer
resource "azurerm_lb" "web_lb" {
  name                = "${var.name_prefix}-lb"
  location            = var.location
  resource_group_name = var.resource_group_name


  frontend_ip_configuration {
    name                 = "PublicIPAddress"
    public_ip_address_id = azurerm_public_ip.lb_public_ip.id
  }
}
Backend Pool
resource "azurerm_lb_backend_address_pool" "web_lb_pool" {
  loadbalancer_id = azurerm_lb.web_lb.id
  name            = "${var.name_prefix}-lb-pool"
}
Health Probe
resource "azurerm_lb_probe" "web_lb_probe" {
  loadbalancer_id = azurerm_lb.web_lb.id


  name     = "${var.name_prefix}-lb-probe"
  protocol = "Tcp"
  port     = 80


  interval_in_seconds = 30
  number_of_probes    = 2
}
Load Balancer Rule
resource "azurerm_lb_rule" "web_lb_rule" {
  loadbalancer_id = azurerm_lb.web_lb.id


  name     = "${var.name_prefix}-lb-rule"
  protocol = "Tcp"


  frontend_port = 80
  backend_port  = 80


  frontend_ip_configuration_name = (
    azurerm_lb.web_lb.frontend_ip_configuration[0].name
  )


  backend_address_pool_ids = [
    azurerm_lb_backend_address_pool.web_lb_pool.id
  ]


  probe_id = azurerm_lb_probe.web_lb_probe.id
}
Attach NICs to Backend Pool
resource "azurerm_network_interface_backend_address_pool_association" "nic_lb_association" {
  for_each = var.instance


  network_interface_id = var.nic_ids[each.key]


  ip_configuration_name = "internal"


  backend_address_pool_id = (
    azurerm_lb_backend_address_pool.web_lb_pool.id
  )
}
outputs.tf
output "lb_public_ip" {
  value = azurerm_public_ip.lb_public_ip.ip_address
}


output "lb_id" {
  value = azurerm_lb.web_lb.id
}
9. Root main.tf

Now your root configuration becomes very simple.

resource "azurerm_resource_group" "myrg" {
  name     = "${local.name_prefix}-${var.resource_group_name}"
  location = var.location


  tags = local.project_tags
}

Then call the networking module:

module "networking" {
  source = "./modules/networking"


  name_prefix = local.name_prefix


  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location


  vnet_name      = var.vnet_name
  subnet_name    = var.subnet_name
  address_space = var.address_space


  project_tags = local.project_tags
}

Call the compute module:

module "compute" {
  source = "./modules/compute"


  name_prefix = local.name_prefix


  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location


  subnet_id = module.networking.subnet_id


  instance = var.instance


  vm_size = var.vm_instance_size["development"]


  ssh_public_key = file(
    "${path.module}/ssh-keys/terraform-azure.pem.pub"
  )
}

Notice this:

subnet_id = module.networking.subnet_id

This is module-to-module communication through outputs.

Then call the Load Balancer:

module "loadbalancer" {
  source = "./modules/loadbalancer"


  name_prefix = local.name_prefix


  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location


  instance = var.instance


  nic_ids = module.compute.nic_ids
}

Now Terraform understands:

Resource Group
      │
      ▼
Networking Module
      │
      │ subnet_id
      ▼
Compute Module
      │
      │ nic_ids
      ▼
Load Balancer Module
10. Root outputs

Create outputs.tf:

output "resource_group_name" {
  value = azurerm_resource_group.myrg.name
}


output "load_balancer_public_ip" {
  value = module.loadbalancer.lb_public_ip
}


output "vm_private_ips" {
  value = module.compute.private_ips
}


output "vnet_id" {
  value = module.networking.vnet_id
