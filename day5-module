4. Root locals.tf
locals {
  name_prefix = "${var.environment}-${var.owner}"


  project_tags = {
    Environment = var.environment
    Owner       = var.owner
    Project     = "dispatch"
  }
}

Notice that instead of hardcoding:

Environment = "dev"

we use:

Environment = var.environment

This makes the module reusable for dev/test/prod.

5. Networking module

Create:

modules/networking/
├── main.tf
├── variables.tf
└── outputs.tf
modules/networking/variables.tf
variable "name_prefix" {
  type = string
}


variable "resource_group_name" {
  type = string
}


variable "location" {
  type = string
}


variable "vnet_name" {
  type = string
}


variable "subnet_name" {
  type = string
}


variable "address_space" {
  type = list(string)
}


variable "project_tags" {
  type = map(string)
}
modules/networking/main.tf
resource "azurerm_virtual_network" "vnet" {
  name                = "${var.name_prefix}-${var.vnet_name}"
  location            = var.location
  resource_group_name = var.resource_group_name


  address_space = var.address_space


  tags = var.project_tags
}


resource "azurerm_subnet" "web_subnet" {
  name                 = "${var.name_prefix}-${var.subnet_name}"
  resource_group_name  = var.resource_group_name
  virtual_network_name = azurerm_virtual_network.vnet.name


  address_prefixes = ["10.0.1.0/24"]
}


resource "azurerm_network_security_group" "web_nsg" {
  name                = "${var.name_prefix}-nsg"
  location            = var.location
  resource_group_name = var.resource_group_name


  tags = var.project_tags
}


locals {
  web_nsg_rule = {
    "110" = "3389"
    "120" = "80"
    "130" = "443"
    "140" = "22"
    "144" = "8080"
  }
}


resource "azurerm_network_security_rule" "web_nsg" {
  for_each = local.web_nsg_rule


  name                        = "Rule_port_${each.key}"
  priority                    = tonumber(each.key)
  direction                   = "Inbound"
  access                      = "Allow"
  protocol                    = "Tcp"
  source_port_range           = "*"
  destination_port_range      = each.value
  source_address_prefix      = "*"
  destination_address_prefix = "*"


  resource_group_name         = var.resource_group_name
  network_security_group_name = azurerm_network_security_group.web_nsg.name
}


resource "azurerm_subnet_network_security_group_association" "web_subnet_nsg" {
  subnet_id                 = azurerm_subnet.web_subnet.id
  network_security_group_id = azurerm_network_security_group.web_nsg.id
}
modules/networking/outputs.tf
output "subnet_id" {
  value = azurerm_subnet.web_subnet.id
}


output "nsg_id" {
  value = azurerm_network_security_group.web_nsg.id
}


output "vnet_id" {
  value = azurerm_virtual_network.vnet.id
}
