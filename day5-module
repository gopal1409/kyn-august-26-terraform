13. GitHub module

After uploading the modules to GitHub, your root configuration can call them directly.

For example:

module "networking" {
  source = "git::https://github.com/YOUR_USERNAME/terraform-azure-web-platform.git//modules/networking?ref=v1.0.0"


  name_prefix = local.name_prefix


  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location


  vnet_name      = var.vnet_name
  subnet_name    = var.subnet_name
  address_space  = var.address_space


  project_tags = local.project_tags
}

Similarly:

module "compute" {
  source = "git::https://github.com/YOUR_USERNAME/terraform-azure-web-platform.git//modules/compute?ref=v1.0.0"


  name_prefix = local.name_prefix


  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location


  subnet_id = module.networking.subnet_id


  instance = var.instance


  vm_size = var.vm_instance_size["development"]


  ssh_public_key = file(
    "${path.module}/ssh-keys/terraform-azure.pem.pub"
  )
}

And:

module "loadbalancer" {
  source = "git::https://github.com/YOUR_USERNAME/terraform-azure-web-platform.git//modules/loadbalancer?ref=v1.0.0"


  name_prefix = local.name_prefix


  resource_group_name = azurerm_resource_group.myrg.name
  location            = azurerm_resource_group.myrg.location


  instance = var.instance
  nic_ids  = module.compute.nic_ids
}

Using a Git tag such as ?ref=v1.0.0 is preferable to always using the changing main branch for reproducible deployments.

