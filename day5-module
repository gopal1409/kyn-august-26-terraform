modules/compute/main.tf
NICs
resource "azurerm_network_interface" "web_nic" {
  for_each = var.instance


  name                = "${var.name_prefix}-${each.key}-nic"
  location            = var.location
  resource_group_name = var.resource_group_name


  ip_configuration {
    name                          = "internal"
    subnet_id                     = var.subnet_id
    private_ip_address_allocation = "Dynamic"
  }
}
Linux VMs
resource "azurerm_linux_virtual_machine" "web_vm" {
  for_each = var.instance


  name                = "${var.name_prefix}-${each.key}-vm"
  location            = var.location
  resource_group_name = var.resource_group_name


  size = var.vm_size


  admin_username = "azureuser"


  network_interface_ids = [
    azurerm_network_interface.web_nic[each.key].id
  ]


  admin_ssh_key {
    username   = "azureuser"
    public_key = var.ssh_public_key
  }


  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }


  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts"
    version   = "latest"
  }


  custom_data = filebase64(
    "${path.root}/app/app.sh"
  )
}

Notice this:

for_each = var.instance

If you have:

instance = {
  vm001 = "vm1"
  vm002 = "vm2"
}

Terraform creates:

vm001 → NIC → VM
vm002 → NIC → VM
modules/compute/outputs.tf
output "nic_ids" {
  value = {
    for name, nic in azurerm_network_interface.web_nic :
    name => nic.id
  }
}


output "vm_ids" {
  value = {
    for name, vm in azurerm_linux_virtual_machine.web_vm :
    name => vm.id
  }
}


output "private_ips" {
  value = {
    for name, nic in azurerm_network_interface.web_nic :
    name => nic.private_ip_address
  }
}
